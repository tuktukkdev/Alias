    {
      "name": "2. Игровые комнаты",
      "item": [
        {
          "name": "Создать комнату",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Host\",\n  \"timer\": 60,\n  \"winScore\": 10,\n  \"difficulty\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Возвращает roomId и playerId\", () => pm.expect(b).to.include.keys(\"roomId\", \"playerId\"));",
                  "pm.collectionVariables.set(\"roomId\", b.roomId);",
                  "pm.collectionVariables.set(\"hostPlayerId\", b.playerId);",
                  "pm.test(\"Ответ быстрее 1000 мс\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },

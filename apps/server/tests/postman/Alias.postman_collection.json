{
  "info": {
    "name": "Alias Online API",
    "description": "Коллекция для тестирования REST API Alias Online: позитивные и негативные проверки регистрации и входа (классы эквивалентности, граничные значения длины пароля), игровых комнат и коллекций слов. Запросы связаны переменными: id пользователя и комнаты передаются между шагами автоматически. Запуск: Collection Runner в Postman или `newman run Alias.postman_collection.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Авторизация",
      "item": [
        {
          "name": "Регистрация — валидные данные",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Возвращает id, username, email\", () => { pm.expect(b).to.include.keys(\"id\", \"username\", \"email\", \"emailVerified\"); });",
                  "pm.test(\"Email ещё не подтверждён\", () => pm.expect(b.emailVerified).to.eql(false));",
                  "pm.test(\"Пароль не возвращается в ответе\", () => pm.expect(b).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"userId\", b.id);",
                  "pm.test(\"Ответ быстрее 1000 мс\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set(\"username\", \"qa_\" + n);",
                  "pm.collectionVariables.set(\"email\", \"qa_\" + n + \"@example.com\");"
                ]
              }
            }
          ]
        },
